<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controls_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.vectras.controls.ControlOverlay
        android:id="@+id/editable_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:splitMotionEvents="true" />

    <HorizontalScrollView
        android:id="@+id/controls_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:alpha="0.5"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        android:translationY="-4dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/runner_controls_toolbar_background"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center_horizontal|top"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/menu_button"
                    style="@style/Widget.VectrasBox.ToolbarIcon"
                    android:contentDescription="@string/menu"
                    app:srcCompat="@drawable/round_menu_24" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/edit_controls_button"
                    style="@style/Widget.VectrasBox.ToolbarIcon"
                    android:contentDescription="@string/edit_controls"
                    app:srcCompat="@drawable/round_edit_24" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/keyboard_button"
                    style="@style/Widget.VectrasBox.ToolbarIcon"
                    android:contentDescription="@string/keyboard"
                    app:srcCompat="@drawable/round_keyboard_24" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/hide_controls_button"
                    style="@style/Widget.VectrasBox.ToolbarIcon"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="@string/hide"
                    app:srcCompat="@drawable/visibility_off" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/stop_machine_button"
                    style="@style/Widget.VectrasBox.ToolbarIcon"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="@string/stop_machine"
                    app:srcCompat="@drawable/power_settings_new_24px" />
            </LinearLayout>
        </FrameLayout>
    </HorizontalScrollView>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/controls_toggle"
        style="@style/Widget.VectrasBox.ToolbarIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:alpha="0.5"
        android:background="@drawable/controls_button1"
        android:contentDescription="@string/controls"
        android:visibility="gone"
        app:srcCompat="@drawable/round_menu_24" />
</FrameLayout>
